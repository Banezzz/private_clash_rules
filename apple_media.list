# Apple services that should NOT inherit 🍎 苹果服务 DIRECT.
# ACL4SSR Apple.list is DOMAIN-SUFFIX,apple.com + 17.0.0.0/8 and loads next.
# First-match-wins: this list must sit above that ruleset, or TV+ / News /
# Music / Intelligence / Developer never leave DIRECT.
#
# China system paths stay on 🍎 苹果服务 (App Store, iCloud, APNs, updates,
# Maps CN). gspe1-ssl.ls.apple.com is omitted on purpose: it is shared by
# Apple News *and* China Maps / eSIM / Wi-Fi Calling region checks.
#
# Process names cover Mac / Windows / Android clients that dial raw 17.0.0.0/8
# or itunes.apple.com hosts the domain rules below do not list.

# -----------------------------------------------------------------------------
# Process — desktop binary + Windows .exe + Android package
# -----------------------------------------------------------------------------
PROCESS-NAME,Music
PROCESS-NAME,Music.exe
PROCESS-NAME,AppleMusic
PROCESS-NAME,AppleMusic.exe
PROCESS-NAME,iTunes
PROCESS-NAME,iTunes.exe
PROCESS-NAME,TV
PROCESS-NAME,TV.exe
PROCESS-NAME,AppleTV
PROCESS-NAME,AppleTV.exe
PROCESS-NAME,News
PROCESS-NAME,News.exe
PROCESS-NAME,com.apple.android.music
PROCESS-NAME,com.apple.atve.androidtv.apple
PROCESS-NAME,com.apple.android.tv
PROCESS-NAME-WILDCARD,com.apple.android.music*
PROCESS-NAME-WILDCARD,com.apple.atve.androidtv.apple*

# -----------------------------------------------------------------------------
# Apple TV+
# -----------------------------------------------------------------------------
DOMAIN-SUFFIX,tv.apple.com
DOMAIN-SUFFIX,appletv.com
DOMAIN,tv.applemusic.com
DOMAIN,hls.itunes.apple.com
DOMAIN,hls-amt.itunes.apple.com
DOMAIN,np-edge.itunes.apple.com
DOMAIN,play-edge.itunes.apple.com
DOMAIN,uts-api.itunes.apple.com
DOMAIN,apple-tv-plus-press.apple.com

# -----------------------------------------------------------------------------
# Apple Music / MusicKit (catalog + audio; artwork on mzstatic stays DIRECT)
# -----------------------------------------------------------------------------
DOMAIN-SUFFIX,music.apple.com
DOMAIN-SUFFIX,applemusic.com
DOMAIN-SUFFIX,musickit.net
DOMAIN,amp-api.music.apple.com
DOMAIN,amp-api.media.apple.com
DOMAIN,audio.itunes.apple.com
DOMAIN,audio-ssl.itunes.apple.com
DOMAIN,aod.itunes.apple.com
DOMAIN,aod-ssl.itunes.apple.com
DOMAIN,mvod.itunes.apple.com
DOMAIN,streamingaudio.itunes.apple.com
DOMAIN-SUFFIX,blobstore.apple.com

# -----------------------------------------------------------------------------
# Apple News (location host gspe1-ssl.ls.apple.com omitted — see header)
# -----------------------------------------------------------------------------
DOMAIN-SUFFIX,apple.news
DOMAIN,news-client.apple.com
DOMAIN,news-client-search.apple.com
DOMAIN,news-edge.apple.com
DOMAIN,news-assets.apple.com
DOMAIN,news-events.apple.com

# -----------------------------------------------------------------------------
# Apple Arcade / Fitness+
# -----------------------------------------------------------------------------
DOMAIN-SUFFIX,arcade.apple.com
DOMAIN-SUFFIX,fitness.apple.com

# -----------------------------------------------------------------------------
# Apple Intelligence / Private Cloud Compute relays
# -----------------------------------------------------------------------------
DOMAIN,apple-relay.apple.com
DOMAIN,apple-relay.cloudflare.com
DOMAIN,apple-relay.fastly-edge.com
DOMAIN,apple-relay.mask.apple-dns.net

# -----------------------------------------------------------------------------
# Developer / TestFlight / App Store Connect (blocked or slow on DIRECT in CN)
# -----------------------------------------------------------------------------
DOMAIN-SUFFIX,developer.apple.com
DOMAIN,developerservices2.apple.com
DOMAIN,devimages-cdn.apple.com
DOMAIN,devstreaming-cdn.apple.com
DOMAIN,appstoreconnect.apple.com
DOMAIN,itunesconnect.apple.com
DOMAIN,testflight.apple.com
DOMAIN,beta.apple.com
DOMAIN-KEYWORD,testflight
