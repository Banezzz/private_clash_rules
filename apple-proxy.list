# Apple services that are region-gated outside mainland China (🍏 苹果代理).
# Loaded before apple-media.list and apple.list, and before Microsoft.list.
# APNs, iCloud, App Store, updates, and Apple Music stay on the DIRECT groups.
# Private Relay (mask.icloud.com) is omitted: proxying it hides every Safari
# request inside those hosts. gspe1-ssl.ls.apple.com is omitted: News shares it
# with Maps, eSIM, and Wi-Fi Calling.

# Apple TV+
DOMAIN-SUFFIX,tv.apple.com
DOMAIN,tv.applemusic.com
DOMAIN,uts-api.itunes.apple.com
DOMAIN,np-edge.itunes.apple.com
DOMAIN,play-edge.itunes.apple.com
DOMAIN,hls.itunes.apple.com
DOMAIN,hls-amt.itunes.apple.com
DOMAIN,hls-svod.itunes.apple.com
PROCESS-NAME,AppleTV.exe
PROCESS-NAME,com.apple.atve.androidtv.appletv

# Apple News
DOMAIN-SUFFIX,apple.news
DOMAIN,news-edge.apple.com
DOMAIN,news-events.apple.com
DOMAIN,news-client.apple.com
DOMAIN,news-assets.apple.com
DOMAIN,news-client-search.apple.com

# Private Cloud Compute relays (exact names from Apple's enterprise host list)
DOMAIN,apple-relay.apple.com
DOMAIN,apple-relay.cloudflare.com
DOMAIN,apple-relay.fastly-edge.com
DOMAIN,cp4.cloudflare.com

# TestFlight region check. Not a keyword: "testflight" also appears in unrelated hosts.
DOMAIN,testflight.apple.com
