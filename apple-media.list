# Apple media (Music, TV, Podcasts, News)
# Loaded before apple.list so these names win over DOMAIN-SUFFIX,apple.com
# and DOMAIN-SUFFIX,itunes.com. Default policy is DIRECT, same as today.
# Switch only this group to a node when a non-local Apple Music / TV+ catalog
# is needed. Push, software update, and iCloud stay on 苹果服务.
#
# Mac process names Music / TV / Podcasts are omitted: they are generic words
# and would steal unrelated apps. Domain rules cover those Mac apps.

DOMAIN-SUFFIX,music.apple.com
DOMAIN-SUFFIX,tv.apple.com
DOMAIN-SUFFIX,podcasts.apple.com
DOMAIN-SUFFIX,apple.news
DOMAIN,hls.itunes.apple.com
DOMAIN,hls-amt.itunes.apple.com
DOMAIN,np-edge.itunes.apple.com
DOMAIN,play-edge.itunes.apple.com
DOMAIN,uts-api.itunes.apple.com
DOMAIN,aod.itunes.apple.com
DOMAIN,aod-ssl.itunes.apple.com
DOMAIN,mvod.itunes.apple.com

# Windows streaming apps and Android packages. iTunes.exe stays on 苹果服务
# because that legacy app also syncs devices.
PROCESS-NAME,AppleMusic.exe
PROCESS-NAME,AppleTV.exe
PROCESS-NAME,AMPLibraryAgent.exe
PROCESS-NAME,com.apple.android.music
PROCESS-NAME,com.apple.atve.androidtv.appletv
