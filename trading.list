# Trading rule set (CEX / DEX / PERP / terminals)
# Process → CEX → PERP/DEX → Terminals/prediction → Market data → RPC → Wallets → Explorers

# -----------------------------------------------------------------------------
# Process
# Desktop binary + Windows .exe + Android package. PROCESS-NAME is the reliable
# fix for apps that dial raw IPs (e.g. Binance CN acceleration nodes).
# -----------------------------------------------------------------------------
# OKX
PROCESS-NAME,OKX
PROCESS-NAME,OKX.exe
PROCESS-NAME,com.okinc.okex.gp
PROCESS-NAME,com.okinc.okex
# Binance
PROCESS-NAME,Binance
PROCESS-NAME,Binance.exe
PROCESS-NAME,com.binance.dev
# Bybit
PROCESS-NAME,Bybit
PROCESS-NAME,Bybit.exe
PROCESS-NAME,com.bybit.app
# MEXC
PROCESS-NAME,MEXC
PROCESS-NAME,MEXC.exe
PROCESS-NAME,com.mexcpro.client
# Bitget
PROCESS-NAME,Bitget
PROCESS-NAME,Bitget.exe
PROCESS-NAME,com.bitget.exchange
# Gate
PROCESS-NAME,Gate
PROCESS-NAME,Gate.exe
PROCESS-NAME,com.gateio.gateio
# TradingView
PROCESS-NAME,TradingView
PROCESS-NAME,TradingView.exe

